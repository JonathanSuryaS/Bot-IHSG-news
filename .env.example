# Copy to .env and fill in. Never commit .env.
# Hermes stores its own LLM + Telegram credentials via `hermes setup` /
# `hermes gateway setup`; these are only for scripts in this repo.

# Where fetcher.py writes snapshots (default: ./data)
BRIEF_DATA_DIR=./data

# Max age (hours) of the latest IHSG close before data counts as stale
BRIEF_MAX_STALE_HOURS=96
